# The native image is built from the unchanged Dockerfile for each libiperf endpoint.
ARG NATIVE_IMAGE

FROM ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336 AS preview-uv
FROM ${NATIVE_IMAGE}

COPY --from=preview-uv /uv /uvx /usr/local/bin/

ENV UV_PYTHON=3.15.0rc3 \
    UV_PYTHON_INSTALL_DIR=/opt/preview-python \
    UV_PROJECT_ENVIRONMENT=/opt/preview-venv \
    VIRTUAL_ENV=/opt/preview-venv \
    PATH="/opt/preview-venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"

# An explicit candidate request prevents falling back to the base image's Python.
RUN uv python install cpython-3.15.0rc3-linux-x86_64-gnu \
    && uv sync --frozen --dev --python 3.15.0rc3

CMD ["/opt/preview-venv/bin/python", "-m", "pytest", "-q"]
